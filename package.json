{
  "name": "shaderroutine",
  "private": true,
  "main": "index.ts",
  "version": "0.1.0",
  "scripts": {
    "start": "NODE_ENV=development expo start",
    "android": "NODE_ENV=development expo run:android",
    "android:build:debug": "pnpm expo:prebuild --platform android && ./android/gradlew -p android :app:assembleDebug",
    "android:build:preview": "eas build --profile preview --platform android",
    "android:build:prod": "eas build --profile production --platform android",
    "ios": "NODE_ENV=development expo run:ios",
    "ios:build:debug": "pnpm expo:prebuild --platform ios && expo run:ios --configuration Debug --device generic --no-bundler --no-install",
    "ios:build:preview": "eas build --profile preview --platform ios",
    "ios:build:prod": "eas build --profile production --platform ios",
    "eas:update:preview": "eas update --channel preview --clear-cache --environment preview && pnpx sentry-expo-upload-sourcemaps dist",
    "eas:update:prod": "eas update --channel production --clear-cache --environment production && pnpx sentry-expo-upload-sourcemaps dist",
    "lint": "eslint . --fix",
    "format": "prettier --check --write --no-error-on-unmatched-pattern ./**/*.{ts,tsx,md} ./**/*.{ts,tsx,md}",
    "test": "jest",
    "expo:check": "expo install --check",
    "expo:customize": "expo customize",
    "expo:doctor": "pnpx expo-doctor --verbose",
    "expo:install": "expo install --pnpm",
    "expo:prebuild": "expo prebuild --clean",
    "tsc:check": "tsc --noEmit",
    "tsc:config": "tsc --showConfig"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "EXPERIMENTAL_CSS_ANIMATIONS_FOR_SVG_COMPONENTS": false,
      "IOS_DYNAMIC_FRAMERATE_ENABLED": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": false
    }
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/config": "^57.0.8",
    "@expo/dom-webview": "~57.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@lodev09/react-native-true-sheet": "3.11.12",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-three/fiber": "^9.7.0",
    "@shopify/react-native-skia": "2.6.2",
    "@typegpu/noise": "^0.12.0",
    "@typegpu/three": "^0.12.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.13",
    "expo-build-properties": "~57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jotai": "^2.20.2",
    "jotai-family": "^1.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-nitro-modules": "~0.37.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-unistyles": "3.3.0",
    "react-native-web": "~0.21.2",
    "react-native-webgpu": "^0.8.4",
    "react-native-worklets": "^0.10.1",
    "reanimated-color-picker": "^5.1.2",
    "three": "^0.185.1",
    "typegpu": "^0.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/three": "^0.183.1",
    "@webgpu/types": "^0.1.72",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "^57.0.7",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^57.0.1",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "jest-expo": "57.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "unplugin-typegpu": "^0.12.2"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
