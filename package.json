{
  "name": "shaderroutine",
  "private": true,
  "main": "index.ts",
  "version": "0.1.0",
  "scripts": {
    "start": "NODE_ENV=development expo start",
    "android": "NODE_ENV=development expo run:android",
    "android:build:preview": "eas build --profile preview --platform android",
    "android:build:prod": "eas build --profile production --platform android",
    "ios": "NODE_ENV=development expo run:ios",
    "ios:build:preview": "eas build --profile preview --platform ios",
    "ios:build:prod": "eas build --profile production --platform ios",
    "eas:update:preview": "eas update --channel preview --clear-cache --environment preview && pnpx sentry-expo-upload-sourcemaps dist",
    "eas:update:prod": "eas update --channel production --clear-cache --environment production && pnpx sentry-expo-upload-sourcemaps dist",
    "lint": "eslint . --fix",
    "format": "prettier --check --write --no-error-on-unmatched-pattern ./**/*.{ts,tsx,md} ./**/*.{ts,tsx,md}",
    "test": "jest",
    "expo:check": "expo install --check",
    "expo:customize": "expo customize",
    "expo:doctor": "pnpx expo-doctor --verbose",
    "expo:install": "expo install --pnpm",
    "expo:prebuild": "expo prebuild --clean",
    "tsc:check": "tsc --noEmit",
    "tsc:config": "tsc --showConfig"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "DISABLE_COMMIT_PAUSING_MECHANISM": true,
      "EXPERIMENTAL_CSS_ANIMATIONS_FOR_SVG_COMPONENTS": false,
      "IOS_DYNAMIC_FRAMERATE_ENABLED": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": false
    }
  },
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/config": "^55.0.8",
    "@hookform/resolvers": "^5.2.2",
    "@lodev09/react-native-true-sheet": "3.9.9",
    "@radix-ui/colors": "^3.0.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-navigation/native": "^7.1.28",
    "@react-three/fiber": "^9.5.0",
    "@shopify/react-native-skia": "2.5.1",
    "@typegpu/noise": "^0.10.0",
    "@typegpu/three": "^0.10.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "expo": "~55.0.9",
    "expo-asset": "~55.0.10",
    "expo-build-properties": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-dev-client": "~55.0.19",
    "expo-file-system": "~55.0.12",
    "expo-font": "~55.0.4",
    "expo-haptics": "^55.0.9",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.9",
    "expo-router": "55.0.8",
    "expo-splash-screen": "~55.0.13",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.11",
    "expo-web-browser": "~55.0.10",
    "jotai": "^2.18.0",
    "jotai-family": "^1.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-native": "0.83.4",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-nitro-modules": "~0.35.0",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-unistyles": "3.0.24",
    "react-native-web": "~0.21.2",
    "react-native-wgpu": "^0.5.8",
    "react-native-worklets": "^0.7.2",
    "reanimated-color-picker": "^4.2.0",
    "three": "^0.183.2",
    "typegpu": "^0.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "@types/three": "^0.183.1",
    "@webgpu/types": "^0.1.69",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "^55.0.10",
    "eslint": "^10.0.3",
    "eslint-config-expo": "^55.0.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "jest-expo": "55.0.11",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "unplugin-typegpu": "^0.10.1"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
